# ─────────────────────────────────────────────────────────────────────────────
# Nexa backend configuration
#
# Copy to `.env` (git-ignored) and fill in real values. Everything here is
# server-side only — it is never sent to the browser. The UI has its own
# ui/.env with public VITE_* values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production | test
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Extra allowed CORS origins (comma-separated). FRONTEND_URL is always allowed.
CORS_ORIGINS=
LOG_LEVEL=INFO

# ── Supabase (backend-only secrets) ──────────────────────────────────────────
# Project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key          # BACKEND ONLY
# Project settings → Database → Connection string → "Session pooler" (IPv4).
# Used for migrations, seeding and the API's direct Postgres access.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres   # BACKEND ONLY
# Only for projects still on the legacy HS256 JWT secret. Projects using the
# newer asymmetric signing keys are verified via JWKS and can leave this empty.
SUPABASE_JWT_SECRET=

# ── LiteLLM proxy (backend-only) ─────────────────────────────────────────────
LITELLM_BASE_URL=https://your-litellm-proxy.example.com
LITELLM_API_KEY=your-litellm-virtual-key                           # BACKEND ONLY
# Model aliases as exposed by your LiteLLM proxy (`model_name` in its config).
# Fast tier: triage, classification, priority, chat, summaries.
NEXA_MODEL_FAST=gpt-4o-mini
# Strong tier: diagnosis, resolution planning, escalation analysis, copilot.
NEXA_MODEL_STRONG=gpt-4o
# Embeddings for knowledge + incident retrieval. Leave empty to use Postgres
# full-text search only (semantic search switches on once this is set).
NEXA_MODEL_EMBEDDING=text-embedding-3-small
# For embeddings straight from Mistral, use NEXA_MODEL_EMBEDDING=mistral/mistral-embed and:
MISTRAL_API_KEY=                                                   # BACKEND ONLY
# Optional comma-separated fallback aliases, tried in order when a call fails.
NEXA_MODEL_FALLBACKS=
# Optional per-task overrides (fall back to the tier defaults above):
# NEXA_MODEL_TRIAGE=
# NEXA_MODEL_DIAGNOSIS=
# NEXA_MODEL_RESOLUTION_PLAN=
# NEXA_MODEL_ESCALATION_ANALYSIS=
# NEXA_MODEL_ASSISTANT=
# NEXA_MODEL_COPILOT=
# NEXA_MODEL_SUMMARY=

# ── Upstash Redis (backend-only) ─────────────────────────────────────────────
# Transient state only: rate limits, locks, copilot sessions, short caches.
# Leave empty in local dev to use an in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=                                          # BACKEND ONLY

# ── Observability: OpenTelemetry → Axiom (backend-only) ──────────────────────
# Leave AXIOM_TOKEN empty to disable export (spans/logs still go to stdout).
AXIOM_TOKEN=                                                       # BACKEND ONLY
AXIOM_DATASET=nexa
AXIOM_DOMAIN=api.axiom.co
OTEL_SERVICE_NAME=nexa-backend

# ── Development seed (scripts/seed.py) ───────────────────────────────────────
# Password given to the seeded demo accounts. Change it for shared projects.
SEED_USER_PASSWORD=
