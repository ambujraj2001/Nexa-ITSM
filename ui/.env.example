# ─────────────────────────────────────────────────────────────────────────────
# Nexa UI configuration
#
# Copy to `.env` (git-ignored). Every VITE_* value is shipped to the browser, so
# only public values belong here. The build fails if a name looks like a secret
# (service role, token, API key, password). Secrets live in backend/.env.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
